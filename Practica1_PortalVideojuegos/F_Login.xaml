<Window x:Class="Practica1_PortalVideojuegos.F_Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inicio de Sesión" Height="620" Width="600"
        WindowStartupLocation="CenterScreen">

	<!-- Fondo de la ventana con degradado oscuro -->
	<Window.Background>
		<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="#0B0B12" Offset="0.0"/>
			<GradientStop Color="#1A1A3A" Offset="1.0"/>
		</LinearGradientBrush>
	</Window.Background>

	<!-- Tarjeta central flotante con sombra (Padding ajustado) -->
	<Border Background="#161625" CornerRadius="20" Margin="35" Padding="25">
		<Border.Effect>
			<DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="10" Opacity="0.5"/>
		</Border.Effect>

		<StackPanel VerticalAlignment="Center">

			<!-- Adorno Neón Superior -->
			<Ellipse Width="60" Height="60" Fill="#00E5FF" Margin="0,0,0,15">
				<Ellipse.Effect>
					<DropShadowEffect Color="#00E5FF" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
				</Ellipse.Effect>
			</Ellipse>

			<!-- Títulos modernos -->
			<TextBlock Text="PORTAL GAMER" Foreground="#00E5FF" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" FontFamily="Segoe UI" Margin="0,0,0,5"/>
			<TextBlock Text="Inicia sesión para acceder al catálogo" Foreground="#A0AEC0" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,30"/>

			<!-- Campo Usuario -->
			<TextBlock Text="USUARIO" Foreground="#A0AEC0" FontSize="12" FontWeight="Bold" Margin="5,0,0,5"/>
			<Border Background="#222236" CornerRadius="10" BorderBrush="#3F3F5A" BorderThickness="2" Margin="0,0,0,20">
				<TextBox x:Name="txtUsuario" Height="35" FontSize="16" Padding="10,4" Background="Transparent" Foreground="White" BorderThickness="0" CaretBrush="White"/>
			</Border>

			<!-- Campo Contraseña -->
			<TextBlock Text="CONTRASEÑA" Foreground="#A0AEC0" FontSize="12" FontWeight="Bold" Margin="5,0,0,5"/>
			<Border Background="#222236" CornerRadius="10" BorderBrush="#3F3F5A" BorderThickness="2" Margin="0,0,0,30">
				<PasswordBox x:Name="txtPassword" Height="35" FontSize="16" Padding="10,4" Background="Transparent" Foreground="White" BorderThickness="0" CaretBrush="White"/>
			</Border>

			<!-- Botón Login -->
			<Button x:Name="btnLogin" Content="INICIAR SESIÓN" Height="45" Margin="0,0,0,15" Cursor="Hand" Click="btnLogin_Click">
				<Button.Style>
					<Style TargetType="Button">
						<Setter Property="Background" Value="#00E5FF"/>
						<Setter Property="Foreground" Value="#0F0F1A"/>
						<Setter Property="FontWeight" Value="Black"/>
						<Setter Property="FontSize" Value="15"/>
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="Button">
									<Border Background="{TemplateBinding Background}" CornerRadius="12">
										<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#66F0FF"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>

			<!-- Botón Salir -->
			<Button x:Name="btnSalir" Content="SALIR DEL PORTAL" Height="40" Margin="0,0,0,20" Cursor="Hand" Click="btnSalir_Click">
				<Button.Style>
					<Style TargetType="Button">
						<Setter Property="Background" Value="#3F3F5A"/>
						<Setter Property="Foreground" Value="White"/>
						<Setter Property="FontWeight" Value="Bold"/>
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="Button">
									<Border Background="{TemplateBinding Background}" CornerRadius="12">
										<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#FF4C4C"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>

			<!-- Mensaje Dinámico -->
			<TextBlock x:Name="lblMensaje" Text="" Foreground="#FF4C4C" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"/>

		</StackPanel>
	</Border>
</Window>
